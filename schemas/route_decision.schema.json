{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "group_id",
    "router_revision",
    "risk_opt",
    "risk_sel",
    "execute",
    "route_probability",
    "route_reason"
  ],
  "properties": {
    "group_id": {
      "type": "string",
      "minLength": 1
    },
    "router_revision": {
      "type": "string",
      "minLength": 1
    },
    "risk_opt": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risk_sel": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risk_decile": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "execute": {
      "type": "boolean"
    },
    "audit_flag": {
      "type": "boolean"
    },
    "route_probability": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "route_reason": {
      "enum": [
        "corrective_budget",
        "random_audit",
        "full_execution_baseline",
        "not_selected"
      ]
    },
    "budget_window_id": {
      "type": "string",
      "minLength": 1
    }
  }
}