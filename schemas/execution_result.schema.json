{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "status",
    "test_suite_hash",
    "image_digest",
    "wall_time_ms",
    "cache_key"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PASS",
        "WRONG_ANSWER",
        "COMPILE_ERROR",
        "RUNTIME_ERROR",
        "TIME_LIMIT",
        "MEMORY_LIMIT",
        "OUTPUT_LIMIT",
        "INVALID_CODE",
        "SANDBOX_ERROR",
        "INFRA_ERROR"
      ]
    },
    "passed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "test_suite_hash": {
      "type": "string",
      "minLength": 1
    },
    "image_digest": {
      "type": "string",
      "minLength": 1
    },
    "wall_time_ms": {
      "type": "number",
      "minimum": 0
    },
    "cpu_time_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "peak_memory_mb": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "stdout_truncated": {
      "type": "boolean"
    },
    "stderr_truncated": {
      "type": "boolean"
    },
    "cache_key": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "infra_message": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}