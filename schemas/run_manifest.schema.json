{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunManifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "run_id",
    "stage",
    "method",
    "seed",
    "started_at",
    "git_commit",
    "contracts_hash",
    "upstream_lock_hash",
    "status"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "git_commit": {
      "type": "string",
      "minLength": 1
    },
    "contracts_hash": {
      "type": "string",
      "minLength": 1
    },
    "upstream_lock_hash": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PLANNED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "ABORTED"
      ]
    },
    "command": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}